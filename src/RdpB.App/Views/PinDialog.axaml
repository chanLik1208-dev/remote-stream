<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RdpB.App.Views.PinDialog"
        Title="輸入配對 PIN"
        Width="320" Height="190" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20" Spacing="12">
    <TextBlock Name="PromptText" TextWrapping="Wrap" />
    <TextBox Name="PinBox" Watermark="6 位數 PIN" MaxLength="6" FontSize="20" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Name="CancelButton" Content="取消" />
      <Button Name="ConnectButton" Content="配對" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
