<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RdpB.App.Views.EditHostDialog"
        Title="編輯裝置"
        Width="420" Height="460" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <!-- 用 TabControl 分頁(基本資訊/連線覆寫),不要疊成一條長 StackPanel——
       同一個教訓剛在 MainWindow 的「設定」「Host」分頁改過一次(見那邊的 commit),
       這個新對話框從一開始就照這個方式做,不要又疊出同一個問題。
       純 code-behind(不另開 ViewModel),跟 PinDialog/LaunchModeWindow 同一個簡單模式。 -->
  <DockPanel Margin="16">
    <TextBlock Name="ErrorText" DockPanel.Dock="Bottom" Margin="0,8,0,0"
               Foreground="OrangeRed" TextWrapping="Wrap" FontSize="12" />
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Name="CancelButton" Content="取消" />
      <Button Name="SaveButton" Content="儲存" IsDefault="True" />
    </StackPanel>

    <TabControl>
      <TabItem Header="基本資訊">
        <StackPanel Spacing="12" Margin="0,12,0,0">
          <StackPanel Spacing="4">
            <TextBlock Text="名稱" />
            <TextBox Name="NameBox" Watermark="可留空用位址代替" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="位址" />
            <TextBox Name="AddressBox" Watermark="例如 192.168.0.50 或 192.168.0.50:7443" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="已配對的憑證指紋(64 字,SHA-256)" />
            <TextBox Name="FingerprintBox" FontFamily="Consolas,monospace" FontSize="12" />
            <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                       Text="清空會讓這台裝置變回「尚未配對」,下次連線要重新走一次 PIN 配對。" />
          </StackPanel>
          <StackPanel Spacing="4">
            <CheckBox Name="RequiresConnectionPasswordCheckBox"
                      Content="每次連線都需要 Host 上設定的連線密碼(無人值守加固)" />
            <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                       Text="要連著 Host 那台機器的「Host」分頁 → 「連線密碼」一起開才會生效——這裡只是告訴 Client 端這台裝置要多問一次密碼,實際驗證在 Host 那邊。" />
          </StackPanel>
        </StackPanel>
      </TabItem>

      <TabItem Header="連線覆寫">
        <StackPanel Spacing="12" Margin="0,12,0,0">
          <CheckBox Name="OverrideCheckBox" Content="這台裝置使用自訂連線/畫質設定(不跟全域預設)" />

          <StackPanel Name="OverridePanel" Spacing="12" Margin="16,0,0,0">
            <StackPanel Spacing="4">
              <TextBlock Text="連線方式" />
              <ComboBox Name="ModeCombo" HorizontalAlignment="Stretch" />
            </StackPanel>
            <CheckBox Name="DisableQuicCheckBox" Content="停用 QUIC(一律直接用 TCP+TLS)" />
            <CheckBox Name="CamouflageCheckBox" Content="DIRECT 時自動套用 RDP 連線偽裝(§7)" />
            <CheckBox Name="DedicatedPortCheckBox" Content="進階:偽裝改連專用埠 3389" Margin="16,0,0,0" />
            <StackPanel Spacing="4">
              <TextBlock Text="影像 fps" />
              <ComboBox Name="FpsCombo" HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="位元率(Kbps)" />
              <NumericUpDown Name="BitrateBox" Minimum="1000" Maximum="100000" Increment="1000" FormatString="F0" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
