<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- DPAPI(System.Security.Cryptography.ProtectedData)是 Windows-only,Core 本體要保持
         跨平台乾淨(為之後的 Mac 版),所以這塊單獨拆出來——Host/Client/App 都參照它。 -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RdpB.Core.Windows</RootNamespace>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RdpB.Core\RdpB.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  </ItemGroup>

</Project>
